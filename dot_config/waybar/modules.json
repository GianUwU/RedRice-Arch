{
  "group/extras": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "extras",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/menu",
      "tray"
    ]
  },
  "group/brightness": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "brightness",
      "transition-left-to-right": false
    },
    "modules": [
      "backlight",
      "backlight/slider"
    ]
  },
  "group/scale": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "scale",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/scale",
      "custom/scale-075",
      "custom/scale-10",
      "custom/scale-133",
      "custom/scale-15"
    ]
  },
  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "audio",
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ]
  },
  "cpu": {
    "format": "{icon}",
    "format-icons": [
      "<span size='14pt'>⠁</span>",
      "<span size='14pt'>⠉</span>",
      "<span size='14pt'>⠙</span>",
      "<span size='14pt'>⠛</span>",
      "<span size='14pt'>⠟</span>",
      "<span size='14pt'>⠿</span>"
    ],
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "CPU Frequency: {avg_frequency} GHz",
    "on-click": "kitty"
  },
  "group/clock-main": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "clock-drawer",
      "transition-left-to-right": true
    },
    "modules": [
      "clock",
      "custom/capsule-btn-main"
    ]
  },
  "custom/capsule-btn-main": {
    "format": "<span size='12pt'>󰅃</span>",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/toggle-capsule.sh"
  },
  "custom/clock-spacer": {
    "format": "",
    "tooltip": false,
    "expand": true
  },
  "group/clock-row": {
    "orientation": "horizontal",
    "modules": [
      "custom/clock-spacer",
      "group/clock-capsule"
    ]
  },
  "group/clock-capsule": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "clock-drawer",
      "transition-left-to-right": true
    },
    "modules": [
      "clock",
      "custom/capsule-btn-capsule"
    ]
  },
  "custom/capsule-btn-capsule": {
    "format": "<span size='12pt'>󰅀</span>",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/toggle-capsule.sh"
  },
  "clock": {
    "interval": 1,
    "format": "<span foreground='#FFFFFF'>{:%H\n%M\n%S}</span>",
    "format-alt": "<span foreground='#89B4FA'>{:%d\n%m\n%y}</span>",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click-right": "~/.config/waybar/scripts/toggle-capsule.sh"
  },
"hyprland/workspaces": {
  "all-outputs": true,
  "persistent-workspaces": {
    "1": "[]",
    "2": "[]",
    "3": "[]",
    "4": "[]",
    "5": "[]",
    "6": "[]",
    "7": "[]",
    "8": "[]",
    "9": "[]"
  },
  "format": "{name}",
  "tooltip": false
},
"custom/workspace-icons": {
  "exec": "/home/gian/.config/waybar/scripts/workspace-icons.py",
  "format": "{}",
  "return-type": "json",
  "align": 1.0,
  "justify": "right",
  "tooltip": false
},
"group/workspaces-pill": {
  "orientation": "horizontal",
  "modules": [
    "custom/workspace-icons",
    "hyprland/workspaces#capsule"
  ]
},
"hyprland/workspaces#capsule": {
  "all-outputs": true,
  "format": "{name}",
  "tooltip": false
},
"custom/menu": {
  "format": "<span size='16pt'>󰅃</span>",
  "tooltip": false,
  "expand": true,
  "icon-spacing": 0
},
"tray": {
  "spacing": 16,
  "reverse-direction": true,
  "icon-size": 16,
  "show-passive-items": false
},
"network": {
  "format-icons": {
    "wifi": [
      "<span size='12pt'>󰤯</span>",
      "<span size='12pt'>󰤟</span>",
      "<span size='12pt'>󰤢</span>",
      "<span size='12pt'>󰤥</span>",
      "<span size='12pt'>󰤨</span>"
    ],
    "ethernet": "<span size='12pt'>󰈀</span>",
    "disabled": "<span size='12pt'>󰤭</span>",
    "disconnected": "<span size='12pt'>󰤩</span>"
  },
  "format-wifi": "{icon}",
  "format-ethernet": "{icon}",
  "format-disconnected": "{icon}",
  "format-disabled": "{icon}",
  "interval": 5,
  "tooltip-format": "{essid}\t{gwaddr}",
  "on-click": "rfkill toggle wifi",
  "menu": "on-click-right",
  "menu-file": "$HOME/.config/waybar/network_menu.xml",
  "menu-actions": {
    "connect": "bash $HOME/.config/waybar/scripts/wifi-connect.sh",
    "open_nm": "nm-connection-editor",
    "disconnect": "nmcli dev status | grep ' wifi ' | grep ' connected ' | awk '{print $1}' | head -1 | xargs -r nmcli device disconnect"
  },
  "tooltip": true,
  "max-length": 20
},
"bluetooth": {
  "interval": 5,
  "format-on": "<span size='14pt'>󰂯</span>",
  "format-off": "<span size='14pt'>󰂲</span>",
  "format-disabled": "<span size='14pt'>󰂲</span>",
  "format-connected": "<span size='14pt'>󰂱</span>",
  "format-no-controller": "span size='14pt'>󰂯</span>",
  "tooltip": true,
  "tooltip-format": "{device_enumerate}",
  "tooltip-format-enumerate-connected": "{device_address}",
  "tooltip-format-enumerate-connected-battery": "{device_address} | Battery: {device_battery_percentage}%",
  "on-click": "rfkill toggle bluetooth",
  "menu": "on-click-right",
  "menu-file": "$HOME/.config/waybar/bluetooth_menu.xml",
  "menu-actions": {
    "connect": "bash $HOME/.config/waybar/scripts/bt-connect.sh",
    "disconnect": "bluetoothctl disconnect $(bluetoothctl info 2>/dev/null | awk '/Device/{print $2}')"
  }
},
"pulseaudio#microphone": {
  "format": "{format_source}",
  "format-source": "<span size='14pt'>󰍬</span>",
  "format-source-muted": "<span size='14pt'>󰍭</span>",
  "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
  "menu": "on-click-right",
  "menu-file": "$HOME/.config/waybar/mic_menu.xml",
  "menu-actions": {
    "input": "bash $HOME/.config/waybar/scripts/audio-input.sh"
  },
  "tooltip": false
},
"pulseaudio/slider": {
  "min": 0,
  "max": 100,
  "orientation": "vertical"
},
"pulseaudio": {
  "interval": 1,
  "max-volume": 100,
  "format": "{icon}",
  "format-icons": [
    "<span size='14pt'>󰕿</span>",
    "<span size='14pt'>󰖀</span>",
    "<span size='14pt'>󰕾</span>"
  ],
  "format-muted": "<span size='14pt'>󰝟</span>",
  "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  "menu": "on-click-right",
  "menu-file": "$HOME/.config/waybar/audio_menu.xml",
  "menu-actions": {
    "output": "bash $HOME/.config/waybar/scripts/audio-output.sh",
    "boost": "bash $HOME/.config/waybar/scripts/audio-boost.sh"
  },
  "reverse-scrolling": true,
  "tooltip": true,
  "tooltip-format": "Volume: {volume}%\n{desc}",
  "ignored-sinks": [
    "Easy Effects Sink"
  ]
},
"backlight/slider": {
  "min": 0,
  "max": 100,
  "orientation": "vertical",
  "device": "intel_backlight"
},
"backlight": {
  "device": "intel_backlight",
  "format": "{icon}",
  "format-icons": [
    "", "", "", "", "", "", "", "", ""
  ],
  "reverse-scrolling": true,
  "smooth-scrolling-threshold": 0.2,
  "tooltip": false
},
"custom/scale": {
  "format": "{text}",
  "exec": "~/.config/waybar/scripts/hypr-scale.sh main",
  "return-type": "json",
  "interval": "once",
  "signal": 12,
  "tooltip": true,
  "tooltip-format": "Focused monitor scale (click to swap wallpaper)",
  "on-click": "/home/gian/.config/hypr/scripts/switch-wallpaper.py",
  "expand": true,
  "icon-spacing": 0
},
"custom/scale-075": {
  "format": "{text}",
  "exec": "~/.config/waybar/scripts/hypr-scale.sh button 0.75",
  "return-type": "json",
  "interval": "once",
  "signal": 12,
  "tooltip": false,
  "on-click": "~/.config/waybar/scripts/hypr-scale.sh set 0.75"
},
"custom/scale-10": {
  "format": "{text}",
  "exec": "~/.config/waybar/scripts/hypr-scale.sh button 1.0",
  "return-type": "json",
  "interval": "once",
  "signal": 12,
  "tooltip": false,
  "on-click": "~/.config/waybar/scripts/hypr-scale.sh set 1.0"
},
"custom/scale-133": {
  "format": "{text}",
  "exec": "~/.config/waybar/scripts/hypr-scale.sh button 1.33",
  "return-type": "json",
  "interval": "once",
  "signal": 12,
  "tooltip": false,
  "on-click": "~/.config/waybar/scripts/hypr-scale.sh set 1.33"
},
"custom/scale-15": {
  "format": "{text}",
  "exec": "~/.config/waybar/scripts/hypr-scale.sh button 1.5",
  "return-type": "json",
  "interval": "once",
  "signal": 12,
  "tooltip": false,
  "on-click": "~/.config/waybar/scripts/hypr-scale.sh set 1.5"
},
"battery#icon":{
  "interval": 5,
  "states": {
    "critical": 10
  },
  "format": "{icon}",
  "format-icons": [
    "<span size='14pt'>󰁺</span>",
    "<span size='14pt'>󰁻</span>",
    "<span size='14pt'>󰁼</span>",
    "<span size='14pt'>󰁽</span>",
    "<span size='14pt'>󰁾</span>",
    "<span size='14pt'>󰁿</span>",
    "<span size='14pt'>󰂀</span>",
    "<span size='14pt'>󰂁</span>",
    "<span size='14pt'>󰂂</span>",
    "<span size='14pt'>󰁹</span>"
  ],
  "format-charging": "<span size='14pt'>󰂄</span>",
  "format-plugged": "<span size='14pt'>󰚥</span>",
  "format-critical": "<span size='14pt'>󰂃</span>",
  "tooltip": true,
  "tooltip-format": "Empty in: {time}",
  "tooltip-format-charging": "Full in: {time}"
},
"battery#percentage":{
  "interval": 5,
  "states": {

    "not-full": 99
  },
  "format-not-full": "{capacity}", 
  "format": ":3",
  "tooltip": true,
  "tooltip-format": "Full in: {time}"
},

"custom/powermenu": {
  "format": "<span size='13pt'>󰐥</span>",
  "menu": "on-click",
  "menu-file": "$HOME/.config/waybar/power_menu.xml",
  "tooltip": false,
  "expand": true,
  "icon-spacing": 0,
  "menu-actions": {
    "shutdown": "systemctl poweroff",
    "reboot": "systemctl reboot",
    "suspend": "systemctl suspend",
    "hibernate": "systemctl hibernate"
  }
}
}
