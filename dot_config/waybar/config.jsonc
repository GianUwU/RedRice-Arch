{
  "reload_style_on_change": true,
  "toggle": true,
  "layer": "top",
  "position": "right",
  "exclusive": true,
  "margin-top": 20,
  "margin-bottom": 20,
  "margin-left": 0,
  "margin-right": 3,
  "fixed-center": true,
  "spacing": 0,
  "include": ["~/.config/waybar/modules.json"],
  "modules-left": [ "group/clock-main", "cpu" ],
  "modules-center": [ "hyprland/workspaces" ],
  "modules-right": [
    "group/extras",
    "pulseaudio#microphone",
    "group/audio",
    "group/brightness",
    "group/scale",
    "battery#icon",
    "battery#percentage",
    "custom/powermenu"
  ]
}
