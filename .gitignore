# General
*~
*.swp
*.swo
.DS_Store

# Temporary files
*.tmp
*.log
/dot_config/hypr/scripts/__pycache__/
/dot_config/waybar/scripts/__pycache__/
/dot_config/swaync/__pycache__/
__pycache__/

# Keep binaries/shared libraries needed for the rice
!/dot_local/lib/libdolphinglass.so
!/dot_config/swaync/libswaync_helper.so
!/dot_config/hypr/plugins/hypr-zstack/*.so

# Vesktop cache & runtime data
/dot_config/vesktop/sessionData/
/dot_config/vesktop/Crashpad/
/dot_config/vesktop/Singleton*
/dot_config/vesktop/state.json

# system/ boot configs are machine-specific — NOT tracked in git.
# They contain hardcoded UUIDs, local paths, and hardware-specific ACPI quirks.
# The installer handles their absence gracefully (all checks are optional).
# To use: copy your own /etc/default/grub → system/grub, etc., locally.
system/grub
system/grub.d/
system/mkinitcpio.conf
system/linux.preset
